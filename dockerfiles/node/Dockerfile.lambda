# Node.js application image for AWS Lambda (container image deployment).
#
# Uses the AWS-provided Lambda Node.js base image, which ships with the
# Lambda Runtime Interface Client (RIC) and Runtime Interface Emulator (RIE)
# preinstalled — the image works in Lambda and is locally invocable via:
#   docker run -p 9000:8080 myapp
#   curl -XPOST http://localhost:9000/2015-03-31/functions/function/invocations \
#     -d '{}'
#
# The two-stage split isolates npm and its install state from the final
# layer cache — production node_modules land cleanly in LAMBDA_TASK_ROOT
# without dragging along npm's cache or dev dependencies.
#
# Expected build context:
#   ./package.json / package-lock.json — dependency manifest
#   ./index.js                         — handler module (CMD: index.handler)
#
# Build (match your Lambda function's architecture):
#   docker build --platform=linux/amd64 --build-arg BASE_TAG=22 \
#       -t myapp-lambda -f Dockerfile.lambda .
#
# Change the handler:
#   Edit CMD below or override at deploy time:
#     aws lambda update-function-configuration --function-name fn \
#       --image-config '{"Command":["mypkg/module.handler"]}'
ARG BASE_TAG=22

FROM public.ecr.aws/lambda/nodejs:${BASE_TAG} AS builder

WORKDIR ${LAMBDA_TASK_ROOT}

COPY package*.json ./
RUN npm ci --omit=dev

FROM public.ecr.aws/lambda/nodejs:${BASE_TAG}

COPY --from=builder ${LAMBDA_TASK_ROOT}/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY . ${LAMBDA_TASK_ROOT}

CMD ["index.handler"]
