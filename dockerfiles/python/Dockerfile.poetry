# Python application image (Poetry + Google Distroless, multi-stage).
#
# Builder is `python:*-slim` with Poetry installed into an isolated
# /opt/poetry tree; runtime is `gcr.io/distroless/python3-debian12:nonroot`.
# Poetry is used to:
#   1. Validate that poetry.lock is in sync with pyproject.toml
#      (`poetry check --lock`).
#   2. Export a hash-pinned requirements.txt for pip.
# pip then installs the locked dependencies into /app/deps with
# --require-hashes for supply-chain integrity. Poetry itself never ships
# to the runtime image.
#
# See Dockerfile.python's header for the "why distroless is the default
# instead of Chainguard" explanation. The Chainguard variant lives in
# Dockerfile.poetry.chainguard.
#
# Notes on Poetry versions:
#   - 1.x: `poetry export` is built in.
#   - 2.x: `poetry export` is provided by `poetry-plugin-export` and must
#     be installed alongside Poetry (e.g.
#     `pip install poetry==2.* poetry-plugin-export`).
#
# IMPORTANT: builder and runtime Python minor versions MUST match. Pin
# the distroless image by digest in production and align `BASE_TAG`.
#
# Expected build context:
#   ./pyproject.toml   - project metadata and dependencies (Poetry-managed)
#   ./poetry.lock      - locked dependency graph (poetry lock)
#   ./main.py          - default entry point (override CMD if different)
#
# Build:
#   docker build --build-arg BASE_TAG=3.12-slim -t myapp -f Dockerfile.poetry .
#
# If your project declares a script entry point under [tool.poetry.scripts],
# change CMD to invoke the script instead of `main.py`.
ARG BASE_TAG=3.12-slim
ARG DISTROLESS_TAG=debian12
ARG POETRY_VERSION=1.8.3

FROM python:${BASE_TAG} AS builder
ARG POETRY_VERSION
WORKDIR /app
ENV POETRY_NO_INTERACTION=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/poetry/bin:$PATH" \
    PYTHONPATH=/opt/poetry

# Install Poetry into an isolated location so it does not depend on the
# builder image's default user or its $HOME layout.
RUN pip install --no-cache-dir --target=/opt/poetry "poetry==${POETRY_VERSION}"

# Validate lockfile is in sync, then export a hash-pinned requirements.txt.
COPY pyproject.toml poetry.lock ./
RUN python -m poetry check --lock && \
    python -m poetry export --only=main -f requirements.txt -o /tmp/requirements.txt

# Install dependencies into a target directory with hash verification.
# --no-deps is required by --require-hashes; the exported file already
# pins the full transitive graph.
RUN pip install --no-cache-dir --no-deps --require-hashes \
        --target=/app/deps -r /tmp/requirements.txt

# Application source.
COPY . /app/src

FROM gcr.io/distroless/python3-${DISTROLESS_TAG}:nonroot
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/deps:/app/src

COPY --from=builder --chown=nonroot:nonroot /app/deps /app/deps
COPY --from=builder --chown=nonroot:nonroot /app/src /app/src

USER nonroot

CMD ["/app/src/main.py"]
