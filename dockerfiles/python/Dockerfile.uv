# Python application image (uv + Google Distroless, multi-stage).
#
# Builder is `python:*-slim` with `uv` bootstrapped via pip; runtime is
# `gcr.io/distroless/python3-debian12:nonroot`. Distroless has no shell
# and no package manager, so dependencies are installed with
# `uv pip install --target=/app/deps` (NOT a venv) — the same reason as
# Dockerfile.python: venv shebangs are absolute paths to the builder's
# Python and would break under distroless.
#
# Lock-file workflow:
#   `uv export --frozen --no-dev` produces a fully resolved, hash-pinned
#   requirements file from `uv.lock`. The build fails loudly if `uv.lock`
#   is out of sync with `pyproject.toml`.
#
# See Dockerfile.python's header for the "why distroless is the default
# instead of Chainguard" explanation. The Chainguard variant lives in
# Dockerfile.uv.chainguard.
#
# IMPORTANT: builder and runtime Python minor versions MUST match. Pin
# the distroless image by digest in production and align `BASE_TAG` to
# the same Python minor.
#
# Expected build context:
#   ./pyproject.toml   - project metadata and dependencies
#   ./uv.lock          - locked dependency graph (uv lock)
#   ./main.py          - default entry point (override CMD if different)
#
# Build:
#   docker build --build-arg BASE_TAG=3.12-slim -t myapp -f Dockerfile.uv .
ARG BASE_TAG=3.12-slim
ARG DISTROLESS_TAG=debian12
ARG UV_VERSION=0.5.11

FROM python:${BASE_TAG} AS builder
ARG UV_VERSION
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1

RUN pip install --no-cache-dir "uv==${UV_VERSION}"

COPY pyproject.toml uv.lock ./
# Export the locked graph to a hash-pinned requirements file, then install
# with --target (no venv, no shebang rewrites). --no-deps is required by
# --require-hashes; the export already pins the full transitive graph.
RUN uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt && \
    pip install --no-cache-dir --no-deps --require-hashes \
        --target=/app/deps -r /tmp/requirements.txt

COPY . /app/src

FROM gcr.io/distroless/python3-${DISTROLESS_TAG}:nonroot
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/deps:/app/src

COPY --from=builder --chown=nonroot:nonroot /app/deps /app/deps
COPY --from=builder --chown=nonroot:nonroot /app/src /app/src

USER nonroot

CMD ["/app/src/main.py"]
