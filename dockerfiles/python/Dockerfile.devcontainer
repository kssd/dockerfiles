# Python devcontainer image for VS Code Remote-Containers / Dev Containers.
#
# Based on the official Microsoft Python devcontainer base image, which ships
# Python 3.12, pip, pipx, git, curl, jq, make, a non-root `vscode` user
# (UID 1000), and common dev utilities. The image is intentionally fat
# compared to the production variants — developer ergonomics over minimal size.
#
# Pinned to a minor version tag (1-3.12-bookworm), not :latest, so builds
# are reproducible and PR reviews can see version bumps.
#
# Extra tools installed here:
#   - build-essential  — native extension compilation (cffi, cryptography, etc.)
#   - direnv           — per-directory environment variables (.envrc)
#   - gh               — GitHub CLI for PR / issue workflows
#   - uv               — fast Python package manager (via pipx)
#   - poetry           — Poetry dependency manager (via pipx)
#   - ruff             — fast linter and formatter
#   - black            — formatter (for projects that use Black)
#   - mypy             — static type checker
#   - pytest           — test runner
#   - ipython          — interactive Python REPL
#   - debugpy          — VS Code Python debugger adapter
#
# All extra tools are pinned to explicit versions.
#
# The base image pre-installs black, mypy, and pytest as root into
# /usr/local/py-utils. Those are re-pinned here as root (before USER vscode)
# so our ARG versions win over future base-image bumps. uv, poetry, ruff, and
# ipython are not in the base and are installed as vscode into the same path.
# debugpy is installed via pip --user so it is importable from project venvs.
#
# This image is paired with .devcontainer/devcontainer.json, which wires
# the VS Code Python extension, workspace mount, and remoteUser.
#
# Build:
#   docker build -t python-dev -f Dockerfile.devcontainer .
#   (normally invoked automatically by VS Code "Reopen in Container")
ARG DEVCONTAINER_TAG=1-3.12-bookworm

FROM mcr.microsoft.com/devcontainers/python:${DEVCONTAINER_TAG}

ARG UV_VERSION=0.4.29
ARG POETRY_VERSION=1.8.4
ARG RUFF_VERSION=0.6.9
ARG BLACK_VERSION=25.1.0
ARG MYPY_VERSION=1.16.1
ARG PYTEST_VERSION=8.4.1
ARG IPYTHON_VERSION=8.27.0
ARG DEBUGPY_VERSION=1.8.7

# The base image bundles a Yarn apt source whose GPG key has expired. Remove
# it before apt-get update so the update does not fail on a signing error.
# hadolint ignore=DL3008
RUN rm -f /etc/apt/sources.list.d/yarn.list \
    && apt-get update && apt-get install --no-install-recommends -y \
        build-essential \
        direnv \
        gh \
    && rm -rf /var/lib/apt/lists/*

# Re-pin tools the base pre-installs as root. Their venvs are root-owned, so
# --force here (still running as root) is required to replace them.
RUN pipx install --force "black==${BLACK_VERSION}" \
    && pipx install --force "mypy==${MYPY_VERSION}" \
    && pipx install --force "pytest==${PYTEST_VERSION}"

USER vscode

ENV PATH="/home/vscode/.local/bin:${PATH}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install tools not provided by the base into /usr/local/py-utils (on PATH).
RUN pipx install "uv==${UV_VERSION}" \
    && pipx install "poetry==${POETRY_VERSION}" \
    && pipx install "ruff==${RUFF_VERSION}" \
    && pipx install "ipython==${IPYTHON_VERSION}"

# Install debugpy via pip --user: VS Code uses it as both a library and a
# CLI adapter, so it must be importable from the project interpreter.
RUN pip install --user --no-cache-dir \
        "debugpy==${DEBUGPY_VERSION}"
